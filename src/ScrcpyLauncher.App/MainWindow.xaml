<Window x:Class="ScrcpyLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:ScrcpyLauncher.App.Navigation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="scrcpy Launcher"
        Icon="Assets/scrcpy-launcher.ico"
        Width="560"
        Height="520"
        MinWidth="500"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TrafficLightButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FF5F57" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="#33000000"
                                     StrokeThickness="1" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.68" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0"
                    Padding="12,9"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SidebarToggleButtonStyle}"
                                Click="OnToggleSidebarClick"
                                ToolTip="Toggle sidebar">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="scrcpy Launcher"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TrafficLightButtonStyle}"
                                Background="#28C840"
                                Click="OnMinimizeWindowClick" />
                        <Button Style="{StaticResource TrafficLightButtonStyle}"
                                Background="#FEBC2E"
                                Click="OnMaximizeWindowClick" />
                        <Button Style="{StaticResource TrafficLightButtonStyle}"
                                Background="#FF5F57"
                                Margin="0"
                                Click="OnCloseWindowClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0"
                        ClipToBounds="True">
                    <Grid Margin="8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Width="36"
                                Height="36"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="7"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8EA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1">
                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         IsChecked="True"
                                         GroupName="NavGroup"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Device">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                    <TextBlock Text="Device" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="NavGroup"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Launch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                    <TextBlock Text="Launch" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="NavGroup"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Recording">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                    <TextBlock Text="Recording" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="NavGroup"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Profile">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                    <TextBlock Text="Profile" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="NavGroup"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Tools">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                    <TextBlock Text="Tools" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundBrush}"
                        CornerRadius="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Content="{Binding CurrentPage}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type navigation:DevicePage}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Margin="16" Style="{StaticResource PanelStackStyle}">
                                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Device" />
                                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="CONNECTED DEVICES" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Select device" />
                                                <ComboBox ItemsSource="{Binding Devices}"
                                                          SelectedItem="{Binding SelectedDevice}"
                                                          DisplayMemberPath="DisplayName" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Style="{StaticResource StatusPillStyle}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource StatusPillTextStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Grid.Column="1"
                                                            Content="Refresh"
                                                            Command="{Binding RefreshDevicesCommand}"
                                                            Margin="6,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="ADB" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Serial / IP" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Margin="0,0,8,0"
                                                             Text="{Binding AdbSerial, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1"
                                                            Content="Pair"
                                                            Command="{Binding AdbPairCommand}"
                                                            Margin="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type navigation:LaunchPage}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Margin="16" Style="{StaticResource PanelStackStyle}">
                                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Launch" />
                                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="FLAGS" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <CheckBox Content="Video" IsChecked="{Binding VideoEnabled}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Audio" IsChecked="{Binding AudioEnabled}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Control" IsChecked="{Binding ControlEnabled}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Fullscreen" IsChecked="{Binding Fullscreen}" Style="{StaticResource FlagCheckStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <CheckBox Content="Stay awake" IsChecked="{Binding StayAwake}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Screen off" IsChecked="{Binding TurnScreenOff}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource FlagCheckStyle}" />
                                                        <CheckBox Content="Pause on error" IsChecked="{Binding PauseOnExitIfError}" Style="{StaticResource FlagCheckStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="VIDEO" />
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Max size" />
                                                        <TextBox Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Max FPS" />
                                                        <TextBox Text="{Binding MaxFps, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Bit rate" />
                                                <TextBox Text="{Binding VideoBitRate, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type navigation:RecordingPage}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Margin="16" Style="{StaticResource PanelStackStyle}">
                                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Recording" />
                                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="OUTPUT" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Save path" />
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Margin="0,0,8,0"
                                                             Text="{Binding RecordPath, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1"
                                                            Content="Browse"
                                                            Command="{Binding BrowseRecordCommand}"
                                                            Margin="0" />
                                                </Grid>
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Window title" />
                                                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="EXTRA ARGUMENTS" />
                                                <TextBox AcceptsReturn="True"
                                                         Height="70"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         TextWrapping="Wrap"
                                                         Text="{Binding AdditionalArguments, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0" />
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type navigation:ProfilePage}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Margin="16" Style="{StaticResource PanelStackStyle}">
                                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Profile" />
                                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="PRESETS" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Active preset" />
                                                <ComboBox ItemsSource="{Binding Presets}"
                                                          SelectedItem="{Binding SelectedPreset}"
                                                          DisplayMemberPath="Name" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Preset name" />
                                                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" />
                                                <WrapPanel Margin="0,-2,0,0">
                                                    <Button Content="Save" Command="{Binding SavePresetCommand}" />
                                                    <Button Content="New" Command="{Binding NewPresetCommand}" />
                                                    <Button Content="Delete"
                                                            Command="{Binding DeletePresetCommand}"
                                                            Style="{StaticResource DangerOutlineButtonStyle}"
                                                            Margin="0" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type navigation:ToolsPage}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Margin="16" Style="{StaticResource PanelStackStyle}">
                                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Tools" />
                                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12" />

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="SCRCPY PATH" />
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Directory" />
                                                <TextBox Text="{Binding ToolsDirectory, UpdateSourceTrigger=LostFocus}" />
                                                <WrapPanel Margin="0,-2,0,0">
                                                    <Button Content="Browse" Command="{Binding BrowseToolsCommand}" />
                                                    <Button Content="Auto-detect"
                                                            Command="{Binding AutoDetectToolsCommand}"
                                                            Margin="0" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,0,0,12">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDetectedTools}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SuccessMutedBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ToolsVersionLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                                <TextBlock Text="{Binding ToolsDetailLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>

                        <Border Grid.Row="1"
                                Style="{StaticResource UtilFooterStyle}"
                                Margin="16,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Launch"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartCommand}"
                                            Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Stop"
                                            Style="{StaticResource DangerOutlineButtonStyle}"
                                            Command="{Binding StopCommand}"
                                            Margin="0" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="View command"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            Click="OnViewCommandClick" />
                                    <Button Grid.Column="2"
                                            Content="View logs"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            Click="OnViewLogsClick" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
